# Normalizar finales de línea: LF en el repositorio, sin importar el SO del colaborador.
# Evita diffs espurios de archivo completo cuando alguien trabaja desde Windows.
* text=auto eol=lf

# Binarios: nunca tocar
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.xlsx binary
*.woff binary
*.woff2 binary

# Archivos que deben conservar CRLF en Windows
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Los .sh deben quedar con LF o no se ejecutan en contenedores Linux
*.sh   text eol=lf

# Definiciones de tipos generadas: excluidas de las estadísticas de linguist
*.min.js linguist-generated=true
*.lock   linguist-generated=true
