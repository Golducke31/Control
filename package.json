{
  "name": "control",
  "version": "0.1.0",
  "private": true,
  "description": "Control · Plataforma SaaS multiempresa para gestión comercial, stock, logística y facturación electrónica.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "node tools/check-workspace-typecheck.mjs && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "dev:web": "npm run dev --workspace @control/web",
    "tokens": "npm run generate --workspace @control/tokens",
    "verify:partitions": "node tools/check-partitioned-tables.mjs",
    "verify:composite-fks": "node tools/check-composite-fks.mjs",
    "verify:migration-order": "node tools/check-migration-order.mjs",
    "verify:suite-sql": "node tools/check-suite-sql.mjs",
    "verify:workflow": "node tools/validate-workflow.mjs",
    "verify:tokens": "node tools/check-token-literals.mjs",
    "verify:tokens-sync": "npm run check --workspace @control/tokens",
    "verify:typecheck-coverage": "node tools/check-workspace-typecheck.mjs",
    "verify:permissions": "node tools/check-permissions.mjs",
    "verify:textos": "node tools/check-textos.mjs",
    "verify": "npm run verify:composite-fks && npm run verify:migration-order && npm run verify:partitions && npm run verify:suite-sql && npm run verify:workflow && npm run verify:tokens && npm run verify:tokens-sync && npm run verify:typecheck-coverage && npm run verify:permissions && npm run verify:textos"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/pg": "^8.11.6",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "zod": "^3.25.76"
  }
}
