{
  "name": "@control/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Frontend de Control. Una ventana por función, sobre Next.js y el sistema de diseño propio.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:a11y": "cross-env CODEBUDDY_SAFE_DELETE_ENABLED=0 playwright test --project=accesibilidad",
    "test:flujos": "cross-env CODEBUDDY_SAFE_DELETE_ENABLED=0 playwright test --project=flujos",
    "test:e2e": "cross-env CODEBUDDY_SAFE_DELETE_ENABLED=0 playwright test",
    "lint:tokens": "node ../../tools/check-token-literals.mjs"
  },
  "dependencies": {
    "@control/contracts": "*",
    "@control/tokens": "*",
    "@control/ui": "*",
    "@tanstack/react-query": "^5.103.1",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.5.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "cross-env": "^10.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.0"
  }
}
