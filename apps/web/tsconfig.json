{
  // ===========================================================================
  // apps/web · configuración propia
  // ===========================================================================
  // La app tiene su propio tsconfig porque el del piso del monorepo no puede
  // cubrirla: compila JSX, necesita los tipos del DOM y resuelve para un empaquetador,
  // mientras el piso resuelve para Node.
  //
  // Que cada workspace declare cómo se chequea es la razón por la que existe
  // `tools/check-workspace-typecheck.mjs`: convierte el olvido en un fallo explícito,
  // en vez de dejar un paquete sin chequear en silencio —que es exactamente el defecto
  // que tuvo el `tsconfig` raíz—.
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "preserve",
    "module": "esnext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    // Los módulos que las suites importan llevan extensión `.ts` en sus imports
    // relativos, porque Node los ejecuta sin compilarlos y su resolutor exige la
    // extensión. Los componentes, que sólo consume el empaquetador, la omiten.
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "incremental": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "allowJs": true
  },
  // `allowJs` y el formato de este archivo los normaliza Next en cada compilación: si
  // se quitan, vuelven en el siguiente build y ensucian el árbol de trabajo. Se dejan
  // como Next los quiere. Lo que sí es decisión propia son las opciones de arriba:
  // `strict`, `noUncheckedIndexedAccess`, `exactOptionalPropertyTypes` y
  // `erasableSyntaxOnly` son más estrictas que las que Next propone por defecto.
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}
